{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kakon77777-commits/SSSP/main/docs/sssp_document.schema.json",
  "title": "SSSP Canonical Scholarly Document v0.1",
  "type": "object",
  "required": ["protocol", "version", "document_id", "title", "revision", "nodes", "semantic_ledger", "claim_ledger"],
  "properties": {
    "protocol": {"const": "SSSP"},
    "version": {"const": "0.1"},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "title": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "checksum"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "type": {"enum": ["heading", "paragraph", "math_block", "definition", "claim", "code", "reference", "note"]},
          "content": {"type": "string"},
          "latex": {"type": "string"},
          "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "semantic_ledger": {"type": "object"},
    "claim_ledger": {"type": "object"}
  }
}
