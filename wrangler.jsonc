{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sssp-evemisslab",
  "main": "site/worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "define": {
    "PACKAGE_VERSION": "\"3.2.1\""
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sssp.evemisslab.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SSSP_STORE",
        "class_name": "SSSPStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SSSPStore"]
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "77701",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
